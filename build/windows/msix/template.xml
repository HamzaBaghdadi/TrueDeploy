<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="truedeploy.exe"
        Arguments=""
        InstallLocation="C:\Program Files\TrueDeploy\TrueDeploy">
    </Installer>
    <PackageInformation
        PackageName="TrueDeploy"
        PackageDisplayName="TrueDeploy"
        PublisherName="CN=TrueDeploy"
        PublisherDisplayName="TrueDeploy"
        Version="0.1.0.0"
        PackageDescription="Server setup and Docker deployments over SSH">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.truedeploy.app"
                Description="Server setup and Docker deployments over SSH"
                DisplayName="TrueDeploy"
                ExecutableName="truedeploy.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>TrueDeploy</DisplayName>
            <PublisherDisplayName>TrueDeploy</PublisherDisplayName>
            <Description>Server setup and Docker deployments over SSH</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="truedeploy.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
